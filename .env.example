DATABASE_URL=postgres://xy_store:xy_store@localhost:5432/xy_store
BIND_ADDR=0.0.0.0:8080
RUST_LOG=xy_store=info,tower_http=info

# Sessions (NFR-17)
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=15

# Login protection (NFR-16)
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Allow public sign-up of business-owner accounts.
ALLOW_OWNER_SIGNUP=true
# Development only: return password-reset tokens in the API response
# (no email provider is configured yet). Never enable in production.
EXPOSE_RESET_TOKENS=false
